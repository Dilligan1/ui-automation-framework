# Активный стенд: local | ci
STAGE=local

# Хосты стенда
UI_HOST_LOCAL=http://localhost:3000
API_HOST_LOCAL=http://localhost:8000

# Браузер
HEADLESS=false
UI_TIMEOUT=20
# Удалённый Selenium (Grid или standalone-контейнер). Пусто — локальный Chrome.
SELENIUM_REMOTE_URL=

# Сбросить стенд перед прогоном (POST /api/reset).
# Выполняется только мастер-процессом, до старта xdist worker'ов.
RESET_BEFORE_RUN=false

# --- Учётные данные по стендам ---------------------------------------------
# Формат: <STAGE>_<ROLE>_EMAIL / <STAGE>_<ROLE>_PASSWORD
# Роли: ADMIN, MODERATOR, USER, MEDIA, PRIVATE, EMPTY, BANNED
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_MODERATOR_EMAIL=
LOCAL_MODERATOR_PASSWORD=
LOCAL_USER_EMAIL=
LOCAL_USER_PASSWORD=
LOCAL_MEDIA_EMAIL=
LOCAL_MEDIA_PASSWORD=
LOCAL_PRIVATE_EMAIL=
LOCAL_PRIVATE_PASSWORD=
LOCAL_EMPTY_EMAIL=
LOCAL_EMPTY_PASSWORD=
LOCAL_BANNED_EMAIL=
LOCAL_BANNED_PASSWORD=

# Хэндлы seed-пользователей — нужны для URL профилей
USERNAME_ADMIN=admin
USERNAME_MODERATOR=moderator
USERNAME_USER=alice_dev
USERNAME_MEDIA=bob_photo
USERNAME_PRIVATE=dave_quiet
USERNAME_EMPTY=eve_new
USERNAME_BANNED=frank_banned

# --- БД стенда (для подготовки состояний, недостижимых через UI) ------------
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=
DB_USER_LOCAL=
DB_PASSWORD_LOCAL=
